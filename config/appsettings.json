{
  // Configuración de FerroSuite. NO escribas aquí contraseñas ni claves:
  // la clave de Gemini se pone desde el programa (Opciones > Clave de Gemini…)
  // y se guarda en %LocalAppData%\FerroSuite, fuera del repositorio.
  "BaseDatos": {
    "Servidor": "(localdb)\\MSSQLLocalDB",
    "TiempoConexionSegundos": 30,
    // "Real": datos de la ferretería (base FerroSuite). "Demo": datos SINTÉTICOS en otra base (FerroSuiteDemo).
    "Modo": "Real",
    "NombreBaseReal": "FerroSuite",
    "NombreBaseDemo": "FerroSuiteDemo"
  },
  "Gemini": {
    "Habilitado": true,
    "Modelo": "gemini-flash-latest",
    "TiempoEsperaSegundos": 60
  }
}
